# Production bootstrap: only values that locate infrastructure or seed the DB.
# Copy to your platform's non-secret environment configuration.
AGENT_API_STORE_BACKEND=sql
AGENT_API_SQL_DRIVER=pgx
AGENT_API_SQL_DIALECT=postgres
AGENT_API_LLM_PROVIDER=nvidia
AGENT_API_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AGENT_API_ARTIFACT_STORE=s3
AGENT_API_AUTH_MODE=jwt
# Model/provider and governance values above seed SQL on first start only.
# Change ongoing runtime settings in Admin -> Health & Cost -> Governance.
