# Production secrets: provide through secret manager or read-only mounted files.
# Never commit real values. Copy names into a private secret store.
AGENT_API_SQL_DSN=postgres://agentapi:REPLACE_ME@postgres.example.com:5432/agentapi?sslmode=require
AGENT_API_JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
AGENT_API_ADMIN_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_BYTES
AGENT_API_ARTIFACT_S3_ACCESS_KEY=REPLACE_ME
AGENT_API_ARTIFACT_S3_SECRET_KEY=REPLACE_ME
NVIDIA_API_KEY=REPLACE_ME
# Alternative providers: OPENAI_API_KEY, DEEPSEEK_API_KEY, DASHSCOPE_API_KEY,
# GOOGLE_APPLICATION_CREDENTIALS (mounted path), AGENT_API_RESEND_API_KEY.
