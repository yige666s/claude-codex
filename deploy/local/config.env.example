# Local Compose config — non-secret bootstrap overrides only.
# Copy to deploy/local/config.env; keep deployment-specific values here.
AGENT_API_LLM_PROVIDER=simple
AGENT_API_MODEL=simple
# Set to your real provider/model only when testing model tool calls.
# AGENT_API_LLM_PROVIDER=deepseek
# AGENT_API_MODEL=deepseek-chat

# Real Node canary: leave user IDs empty until authenticated canary testing is approved.
# Endpoint/profile/quotas are managed by the active DB sandbox policy revision.
AGENT_API_SANDBOX_CANARY_USER_IDS=
AGENT_API_SANDBOX_SKILL_IDS=
AGENT_API_SANDBOX_NODE_CREDENTIAL_REF=node_dev

# Prior generated outputs are not sent back to Node as task input.
AGENT_API_SANDBOX_WORKSPACE_EXCLUDE_DIRS=generated-artifacts
